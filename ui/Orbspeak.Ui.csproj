<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Orbspeak</AssemblyName>
    <RootNamespace>Orbspeak.Ui</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2651.64" />
    <ProjectReference Include="..\shared\Orbspeak.Shared.csproj" />
  </ItemGroup>
  <Target Name="CopyReactToApp" BeforeTargets="Build" Condition="Exists('$(ProjectDir)..\package.json')">
    <Exec Command="npm run build:no-check" WorkingDirectory="$(ProjectDir).." IgnoreExitCode="false" />
    <ItemGroup>
      <_DistFiles Include="$(ProjectDir)..\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DistFiles)" DestinationFolder="$(OutputPath)app\%(RecursiveDir)" />
  </Target>
  <Target Name="IncludeAppInPublish" AfterTargets="Build">
    <ItemGroup>
      <_AppFiles Include="$(OutputPath)app\**\*" Condition="Exists('$(OutputPath)app')" />
      <ResolvedFileToPublish Include="@(_AppFiles)" RelativePath="app\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>

